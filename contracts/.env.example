# WHICH CHAIN THIS RUN IS FOR. Required by every broadcasting script and
# deliberately WITHOUT a default: the operator states it, the script compares it
# to block.chainid, and a mismatch refuses before anything is sent. 8453 is Base
# mainnet, 84532 is Base Sepolia. The point is that two independent statements
# -- this and --rpc-url -- have to agree, so a mistyped alias is caught rather
# than executed. Hard Rule 1 makes a mainnet deploy permanent.
EXPECTED_CHAIN_ID=84532

# Throwaway deployer for the spike only. Generate with: cast wallet new
# TESTNET ONLY. On Base mainnet the scripts refuse to read this at all.
SPIKE_DEPLOYER_KEY=0xYOUR_THROWAWAY_PRIVATE_KEY

# The mainnet deployer, read ONLY on chain 8453, and refused if it holds the
# same value as the throwaway above.
#
# Whoever broadcasts the constructor becomes the PERMANENT OWNER of the piece:
# Ownable(msg.sender), renounceOwnership reverts, and the owner can setRenderer,
# setWarden, setSunset, pause and setUpgrade. The key above has signed every
# testnet deploy and rehearsal since 2026-08-29 and has never been handled as
# though it were valuable, which is exactly why mainnet reads a different name.
#
# Better than either: deploy from a hardware wallet or a Safe with --ledger and
# leave this unset, then hand ownership to a multisig. Ownable2Step is in use,
# so that handover is two steps and a wrong address is recoverable.
MAINNET_DEPLOYER_KEY=
# The Warden address for Plan 1 deploys. If unset, DeployPlan1.s.sol falls
# back to the deployer's own address (fine for a testnet smoke deploy only --
# a real deployment must set this explicitly, since only setWarden can fix a
# wrong value after deploy).
WARDEN_ADDRESS=0xYOUR_WARDEN_ADDRESS
# Alchemy RPC URLs. Use an MRO-SPECIFIC key, not one shared with another
# project: a shared key means a leak or a rate-limit hits both.
ALCHEMY_BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_API_KEY
ALCHEMY_BASE_MAINNET_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_API_KEY
# Etherscan V2 key (works for Base via ?chainid=)
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_V2_KEY
# OpenSea API v2 key, Task 10 only
OPENSEA_API_KEY=YOUR_OPENSEA_KEY
# The domain used inside QR payloads. DECIDED and registered 2026-09-03:
# machinereadableonly.com. A bitmap encodes its own url, so every code must be
# re-solved against this value before any mainnet mint -- a bitmap solved
# against example.com cannot carry over. See docs/2026-09-03-mro-domain-decision.md.
MRO_DOMAIN=machinereadableonly.com
