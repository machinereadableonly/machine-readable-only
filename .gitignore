# NO TRAILING SLASH. `node_modules/` matches a DIRECTORY only, so a SYMLINK
# named node_modules -- which is how a worktree gets its dependencies -- was not
# ignored, and `git add -A` tracked the link. Its blob is the target path, an
# absolute home path, published in the tree. Without the slash the pattern
# matches the name whatever it is.
node_modules
contracts/out/
contracts/cache/
contracts/broadcast/
tools/out/
*.png

# Real secret files, at any depth. The .example schema file stays tracked.
#
# `.env` alone matches ONLY a file named exactly that. On 2026-09-03 a backup
# named `.env.bak.<timestamp>` slipped past it and was committed by a
# `git add -A`, secret and all -- caught by tools/prepublish-check.mjs before
# it was ever pushed. The patterns below close that: anything that starts with
# `.env.` is a real configuration file unless it is a schema.
.env
.env.*
*.env.bak*
!*.env.example
!*.env.template

# SDD scratch workspace (ledgers, briefs, review packages) -- not part of the piece
.superpowers/
