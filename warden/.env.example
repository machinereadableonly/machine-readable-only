# The Warden's configuration. Copy to .env and fill in. chmod 600.
# Plan 2 holds NO private key: chain access here is read-only.

# The public hostname the piece is served from, no scheme.
MRO_DOMAIN=

# HMAC secret for the stateless entry challenge. 32 random bytes, base64.
CHALLENGE_SECRET=

# Read-only Base RPC endpoint. LOAD-BEARING FOR EVERY WRITE, not just the
# rebind re-check it was added for: mint, checkin, upgrade and seed each read
# the contract's own gates (sunset, pause, resting, wallet cap) before queueing
# anything, because the mirror cannot know any of them. If this is unreachable
# those tools REFUSE rather than queue a write the chain would revert -- so a
# flaky endpoint here shows up as refused mints, not as lost money.
BASE_RPC_URL=

# The deployed token contract.
MRO_CONTRACT_ADDRESS=

# The chain the address above is on. 8453 is Base mainnet; 84532 is Base
# Sepolia. Published to agents at mro://contract, so it must match the address
# above rather than being assumed.
MRO_CHAIN_ID=8453

# Where USDC is received. An ADDRESS ONLY -- the key for it is not on this box.
# The zero address and 0x...dEaD are treated as placeholders: allowed on Base
# Sepolia (84532), refused at startup on any other chain, because USDC settled
# to either of them is gone.
TREASURY_ADDRESS=

# The x402 facilitator that verifies and settles payments. Required.
#   testnet: https://x402.org/facilitator          (no API key, Base Sepolia only)
#   mainnet: https://api.cdp.coinbase.com/platform/v2/x402   (CDP API key)
# The payment network is NOT configured here -- it is derived from
# MRO_CHAIN_ID above, so the price is always quoted on the chain the token
# lives on.
X402_FACILITATOR_URL=https://x402.org/facilitator

# The CDP facilitator's credentials. Needed ONLY when X402_FACILITATOR_URL is
# Coinbase's host, which is the only facilitator that settles on Base mainnet
# and which answers 401 without them -- the Warden refuses to start if that url
# is set and these are not, because the alternative is a piece that boots
# healthy and refuses every mint forever.
#
# CDP_API_KEY_SECRET is the base64 Ed25519 key CDP issues (64 bytes: the seed
# and its public half). Leave both empty for the testnet facilitator, which
# takes no key at all -- that is its correct configuration, not a gap.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Where the mirror lives on disk.
STATE_DB_PATH=./state.db

# THE CLOCK'S SIGNER -- two more variables that belong in the real file but are
# deliberately NOT listed here as empty names to fill in:
#
#   CLOCK_PRIVATE_KEY   the Clock's signing key
#   CLOCK_ADDRESS       that key's public address
#
# Both are APPENDED by scripts/make-clock-key.sh and neither is ever typed by
# hand. They are commented out rather than left blank because the script appends
# them, so a blank line copied from here would leave the file holding the same
# name twice. The Warden itself holds no key and deletes CLOCK_PRIVATE_KEY from
# its own environment at startup; only the Clock, run by its systemd timer
# against this same file, reads it. CLOCK_ADDRESS is public -- it exists so that
# asking "which address is the Clock?" never has to read the secret half.

# THE CLOCK'S OPTIONAL SETTINGS. All three have working defaults, so a file
# without them runs correctly -- they are listed because a schema that omits a
# variable the code reads is a schema somebody has to read the source to trust,
# and 4.L5 found all three missing.
#
# MAX_GAS_GWEI is the ceiling above which a run writes NOTHING and waits for a
# cheaper night; a pending row keeps its own day number, so nothing is lost by
# waiting. Default 0.05, which is far above Base's 0.006 floor.
#MAX_GAS_GWEI=0.05
#
# Where the reconcile cursor and the run lock live. Both default to sitting
# beside STATE_DB_PATH, which is what production uses. Override them only to
# run a second Clock against a scratch mirror -- pointing a rehearsal at the
# real lock would block the real run.
#CLOCK_CURSOR_PATH=
#CLOCK_LOCK_PATH=
