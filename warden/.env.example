# The Warden's configuration. Copy to .env and fill in. chmod 600.
# Plan 2 holds NO private key: chain access here is read-only.

# The public hostname the piece is served from, no scheme.
MRO_DOMAIN=

# HMAC secret for the stateless entry challenge. 32 random bytes, base64.
CHALLENGE_SECRET=

# Read-only Base RPC endpoint. LOAD-BEARING FOR EVERY WRITE, not just the
# rebind re-check it was added for: mint, checkin, upgrade and seed each read
# the contract's own gates (sunset, pause, resting, wallet cap) before queueing
# anything, because the mirror cannot know any of them. If this is unreachable
# those tools REFUSE rather than queue a write the chain would revert -- so a
# flaky endpoint here shows up as refused mints, not as lost money.
BASE_RPC_URL=

# The deployed token contract.
MRO_CONTRACT_ADDRESS=

# The chain the address above is on. 8453 is Base mainnet; 84532 is Base
# Sepolia. Published to agents at mro://contract, so it must match the address
# above rather than being assumed.
MRO_CHAIN_ID=8453

# Where USDC is received. An ADDRESS ONLY -- the key for it is not on this box.
# The zero address and 0x...dEaD are treated as placeholders: allowed on Base
# Sepolia (84532), refused at startup on any other chain, because USDC settled
# to either of them is gone.
TREASURY_ADDRESS=

# The x402 facilitator that verifies and settles payments. Required.
#   testnet: https://x402.org/facilitator          (no API key, Base Sepolia only)
#   mainnet: https://api.cdp.coinbase.com/platform/v2/x402   (CDP API key)
# The payment network is NOT configured here -- it is derived from
# MRO_CHAIN_ID above, so the price is always quoted on the chain the token
# lives on.
X402_FACILITATOR_URL=https://x402.org/facilitator

# Where the mirror lives on disk.
STATE_DB_PATH=./state.db
