# The seed agent's configuration. SCHEMA ONLY -- no real values here.
#
# INSTALL: `deploy/install-seed-agent.sh` writes ~/.mro/seed.env from this,
# chmod 600. It lives outside the worktree because everything the seed agent
# needs at runtime lives outside the worktree; see the project's
# secrets-outside-the-worktree note. Nothing in this file is secret today, and
# keeping it beside the identity means there is one place to look.
#
# systemd reads it with EnvironmentFile=, so: no quotes, no `export`, no shell
# expansion. A line is NAME=value, literally.

# Which token this agent beats. There is no default and there must not be one:
# token #1 does not exist until deploy day, and a unit that fell back to some
# id would check in for a token this agent does not hold, be refused, and look
# like a network problem.
MRO_SEED_TOKEN=1

# The site to talk to. This is what gets SIGNED, so it must be the public
# origin, not an internal address. Base Sepolia and Base mainnet are the same
# origin -- the chain is the Warden's configuration, not the client's -- so
# this line does not change at the mainnet cutover.
MRO_SEED_SITE=https://machinereadableonly.com

# The first UTC day token #1 may check in, as YYYY-MM-DD: the day the door
# opens plus 2. A mint credits its own day and same-day finishers are placed by
# lowest token id, so any earlier day lets token #1 tie or beat an agent that
# arrived on opening day and never missed. Empty fails the unit on purpose.
# Deploy day sets it.
MRO_SEED_NOT_BEFORE=
