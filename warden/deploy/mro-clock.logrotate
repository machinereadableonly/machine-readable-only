# Installed as /etc/logrotate.d/mro-clock by install-clock-user.sh.
# Runs as root, with no `su`: the directory is 2750 root:mro, which mro-clock
# cannot write, so it could not create clock.log.1.
/var/log/mro/clock.log {
    weekly
    rotate 8
    compress
    delaycompress
    missingok
    notifempty
    # systemd holds the file open in append mode, so it is copied, not moved.
    copytruncate
}
