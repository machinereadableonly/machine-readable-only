# Rotation for the seed agent's log.
#
# The unit appends to one file forever (StandardOutput=append:), so without
# this the log is unbounded. Modelled on the Clock's, and every load-bearing
# choice there is load-bearing here for the same reason.
#
# INSTALL: this is a TEMPLATE. `deploy/install-seed-agent.sh` substitutes
# __LOG_DIR__ and writes the real config to ~/logs/mro-seed-logrotate.conf.
# The template carries no absolute home path, because a home path in a tracked
# file names the account -- `tools/prepublish-check.mjs` fails on one.
#
# It runs from the seed unit's own ExecStartPre rather than from a timer of its
# own: the log only grows when the seed agent runs, so that is exactly the
# right cadence, and it needs no second unit to enable and no root.

__LOG_DIR__/mro-seed.log {
    # One check-in prints a key id, the door's timing line and the tool's
    # answer -- under a kilobyte. This is years of history either way. Size is
    # the real ceiling; weekly just bounds how old the newest rotation can be
    # when the agent has been quiet.
    weekly
    size 1M
    rotate 8
    compress
    delaycompress

    # COPYTRUNCATE IS LOAD-BEARING, not a preference. systemd holds an open
    # append fd to this file for the whole run; a rename-and-create rotation
    # would leave it writing to the rotated file, and the new one would stay
    # empty forever. copytruncate keeps the inode, so the fd stays valid.
    #
    # It also means the mode is never re-created, so the file keeps the 0600
    # it was given -- which is why there is no `create` line here.
    copytruncate

    missingok
    notifempty
}
