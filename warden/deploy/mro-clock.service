[Unit]
Description=Machine Readable Only -- the Clock, writing the day's queue to Base
Documentation=file://%h/projects/machine-readable-only/docs/plans/2026-08-31-mro-plan3-clock.md
# The mirror is a local SQLite file and the chain is remote, so a run started
# before the network is up would fail its very first eth_gasPrice.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/projects/machine-readable-only/warden
# 16.10. Rotate before the run, not from a timer of its own: this log only
# grows when the Clock runs, so the Clock is exactly the right cadence, and it
# needs no second unit to enable and no root. The leading "-" makes a failure
# non-fatal -- rotation must never be the reason a night's check-ins are lost --
# so a missing config (generated by deploy/install-clock-logging.sh, and not
# tracked because it must carry an absolute path) degrades to no rotation.
#
# copytruncate is why this is safe while systemd holds the log open; see
# deploy/mro-clock-logrotate.conf.example.
ExecStartPre=-/usr/sbin/logrotate --state %h/logs/mro-logrotate.status %h/logs/mro-clock-logrotate.conf

# --env-file, not EnvironmentFile=: the file holds CLOCK_PRIVATE_KEY, and this
# way it is read by node itself rather than by systemd, so the key never
# appears in `systemctl show`, in the journal's unit metadata, or in a
# `systemd-analyze dump`.
ExecStart=%h/.nvm/versions/node/v24.14.1/bin/node --env-file=.env src/clock/main.mjs
# One run is a handful of transactions plus a paged log read. Ten minutes is
# generous; a run still going after that is stuck, and killing it is correct
# because the next run re-reads the world rather than resuming a plan.
TimeoutStartSec=600

# The Clock reads a private key. It has no business anywhere else on the box.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/projects/machine-readable-only/warden %h/logs
ProtectKernelTunables=true
# NOT ProtectKernelModules=true. This is a USER unit, and that directive works
# by removing CAP_SYS_MODULE from the capability bounding set (systemd.exec(5)).
# Setting a bounding set needs CAP_SETPCAP, which an unprivileged user manager
# does not have, so systemd refuses to start the service at all:
# "Failed to drop capabilities: Operation not permitted", status 218/CAPABILITIES.
# Measured 2026-09-03: it fails on its own, three runs out of three, while every
# other directive here passes.
#
# The line below keeps the half that actually works unprivileged -- the seccomp
# filter blocking the module syscalls. The capability half was never protecting
# anything here: this process runs as an ordinary user and has no CAP_SYS_MODULE
# to lose.
SystemCallFilter=~@module
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

# A run that is OOM-killed must not take the user's whole slice with it. See
# the project's notes on the 2026-08-28 incident.
OOMPolicy=continue
MemoryMax=1G

# 16.10. The log below is world-readable at the inherited 0022 (the user
# manager's default, per systemd.exec(5)), in a 0755 directory under a 0755
# home, on a box shared with six other projects. A url in an error message is
# where a managed RPC provider keeps its api key, so the text is redacted at
# source (src/clock/redact.mjs) AND the file is kept private here. Both, because
# either one alone is a single point of failure for a credential.
#
# UMask governs FILE CREATION only, so it covers a log that has been deleted or
# has not been written yet; the existing file was chmod 600 by hand, and
# logrotate keeps that mode by using copytruncate rather than creating a new
# file. UMask is legal in a user unit -- systemd.exec(5) documents its user-unit
# default -- unlike ProtectKernelModules, which needed CAP_SETPCAP and was
# removed in 623f9a5.
UMask=0077

StandardOutput=append:%h/logs/mro-clock.log
StandardError=append:%h/logs/mro-clock.log
