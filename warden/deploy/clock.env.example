# The Clock's own configuration, at /etc/mro-clock/clock.env (mro-clock, 600).
# NEVER EDITED BY HAND: deploy/install-clock-user.sh writes it with
# deploy/clock-env.mjs from the Warden's .env. Change the Warden's file and
# re-run the installer. See DEPLOY.md section 12.

# Copied from the Warden's .env.
BASE_RPC_URL=
MRO_CONTRACT_ADDRESS=
MRO_CHAIN_ID=
# Copied only when the Warden's .env sets it; the Clock defaults to 0.05.
#MAX_GAS_GWEI=

# Copied from the Warden's .env when it is there, else kept from this file.
CLOCK_PRIVATE_KEY=

# Fixed by the installer.
STATE_DB_PATH=/var/lib/mro/state.db
MRO_SPLIT_SEED_FILE=/etc/mro-clock/split-seed
MRO_QUESTION_BANK=/var/lib/mro/questions/bank.json
