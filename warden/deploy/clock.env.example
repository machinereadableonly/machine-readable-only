# The Clock's own configuration, at /etc/mro-clock/clock.env (mro-clock, 600).
# NEVER EDITED BY HAND: deploy/install-clock-user.sh writes it with
# deploy/clock-env.mjs from the Warden's .env. Change the Warden's file and
# re-run the installer. See DEPLOY.md section 12.

# Copied from the Warden's .env.
BASE_RPC_URL=
MRO_CONTRACT_ADDRESS=
MRO_CHAIN_ID=
MRO_DOMAIN=
TREASURY_ADDRESS=
# Copied only when the Warden's .env sets them. The Clock defaults to 0.05 gwei
# and to the ceilings in src/clock/run.mjs.
#MAX_GAS_GWEI=
#MRO_HOUSE_KEY_ID=
# A second RPC from a different provider; required on Base mainnet, where it
# is https://mainnet.base.org.
#CLOCK_CHECK_RPC_URL=
# The Safe that must own the contract, alone; required on Base mainnet.
#MRO_OWNER_SAFE=
#CLOCK_MAX_MINTS=
#CLOCK_MAX_SEEDS=
#CLOCK_MAX_MARKS=
#CLOCK_MAX_CREDITS=

# Copied from the Warden's .env when it is there, else kept from this file.
CLOCK_PRIVATE_KEY=

# Fixed by the installer.
STATE_DB_PATH=/var/lib/mro/state.db
MRO_SPLIT_SEED_FILE=/etc/mro-clock/split-seed
MRO_QUESTION_BANK=/etc/mro-clock/bank.json
CLOCK_LEDGER_PATH=/var/lib/mro-clock/ledger.db
