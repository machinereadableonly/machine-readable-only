# Example nginx vhost for the Warden. NOT active configuration -- this is the
# template `deploy/install-warden-site.sh` fills in and installs. See DEPLOY.md
# for the full ordered runbook.
#
# This vhost is a PURE PROXY. Every route, including the door page and
# llms.txt, is answered by the Warden process on 127.0.0.1:3006.
#
# It did not used to be. Until 2026-09-03 this template served `/`,
# `/llms.txt`, `/client.mjs`, `/skill.md` and the key directory from disk with
# `root /srv/mro/warden/public`. That could never have worked from a checkout:
# nginx runs as www-data, the repository lives under /home/<user>/projects
# which is mode 0750, and www-data cannot traverse it. The `/srv/mro` path in
# the old template implied a COPY of public/, which drifts from the repository
# the moment the copy is not refreshed -- and refreshing it needs sudo every
# time a document changes. Serving from the process that already holds the
# content removes the permission problem and the drift together.
#
# Two routes named in the old template do not exist and are EXPECTED to 404:
# `/client.mjs` and `/skill.md`. llms.txt says so in plain words, so this is
# disclosed behaviour rather than an oversight; do not "fix" it by inventing
# files. They become real when the client is published.
#
# IMPORTANT -- do not "fix" this to trust the Host header. The Warden pins the
# RFC 9421 signature's @authority component to its own CONFIGURED domain
# (config.domain, read from MRO_DOMAIN), never to whatever Host arrives on
# the request. nginx forwards the original Host below because upstream
# application logic may legitimately want it, but the signature check does not
# use it, so a forged or mismatched Host header cannot move which authority a
# signature is checked against.
#
# HTTP only. certbot's --nginx plugin adds the TLS server block and the
# port-80 redirect once the certificate exists -- this is the same shape the
# other sites on this box use, and it is why the challenge can be answered
# before any certificate is present.

# RATE LIMITS ON THE TWO UNSIGNED WRITE PATHS.
#
# `POST /keys` is the way in for an agent with no domain of its own, and
# `GET /keys/nonce` is the value it signs to get there. Neither can carry a
# signature -- registering is how a caller becomes able to sign at all -- so the
# only budget the application can charge is per-thumbprint, and a fresh Ed25519
# keypair is free. That makes the aggregate nginx's job, exactly as the protocol
# document already claims: "Rate limiting that is nginx's job, not this
# handler's". Until now that sentence described nothing.
#
# WHAT THIS DOES AND DOES NOT BUY, stated plainly because the difference
# matters. `$binary_remote_addr` is the address nginx sees. This origin does NOT
# have nginx's real_ip module configured, so for traffic arriving through
# Cloudflare that address is a Cloudflare EDGE ip, not the client's. The limit
# therefore buckets by edge node rather than by caller: real protection against
# one host hammering the origin directly, partial against a distributed flood
# through the proxy. Do not "improve" it by keying on CF-Connecting-IP or
# X-Forwarded-For while the origin lock below is off -- those headers are
# forgeable by anyone who can reach this box, and an attacker rotating one gets
# a fresh bucket per request, which is worse than no limit because it reads
# like one. The honest upgrade path is: turn the origin lock on, THEN configure
# set_real_ip_from + real_ip_header, and this same directive starts metering
# real clients.
#
# These live at file scope on purpose: sites-enabled/* is included inside
# http{}, which is the only context limit_req_zone is valid in. 10m holds
# roughly 160,000 addresses.
limit_req_zone $binary_remote_addr zone=mro_keys:10m rate=10r/m;

# 503 is the nginx default and means "the server is broken". A caller that has
# been rate limited is not looking at a broken server, and 429 is the answer
# that tells it to slow down rather than to retry harder or report an outage.
limit_req_status 429;

server {
    listen 80;
    listen [::]:80;
    server_name <domain>;

    # Hardening follow-up, NOT enabled at first deploy: the Cloudflare origin
    # lock used by the other sites on this box. The map lives in
    # /etc/nginx/conf.d/cloudflare-allowlist.conf and is global.
    #
    # Enable it only AFTER certbot has issued and the Cloudflare proxy is back
    # ON (orange cloud). Enabling it while the proxy is off makes the origin
    # return 403 to everything, including your own checks, which looks exactly
    # like a broken deploy. 127.0.0.1 is allowlisted, so local curl still works.
    #
    #   if ($cf_real_ip_ok = 0) { return 403; }

    # ALSO NOT enabled at first deploy, and enabled only in the same step as the
    # line above -- never before it. With real_ip on, the rate limits below meter
    # the real caller instead of the Cloudflare edge node that proxied the
    # request. That is only safe once the origin lock refuses connections that
    # did not arrive through Cloudflare, because until then CF-Connecting-IP can
    # be set by anyone who can reach the box, and an attacker rotating it gets a
    # fresh bucket per request -- worse than no limit, because the config reads
    # as though it protects something.
    #
    # `warden/deploy/install-nginx-rate-limits.sh` adds both halves to an
    # already-installed vhost and proves the limiter fires afterwards. The
    # ranges are Cloudflare's published set (https://www.cloudflare.com/ips-v4
    # and ips-v6), the same 15 v4 + 7 v6 the global allowlist map carries.
    # Re-fetch them rather than trusting this copy; Cloudflare does change them.
    #
    #   real_ip_header    CF-Connecting-IP;
    #   set_real_ip_from  <each Cloudflare range>;
    #
    # The origin lock keeps working unchanged either way: its map is keyed on
    # $realip_remote_addr, which nginx documents as the address BEFORE any
    # real_ip rewrite.

    # Declared once at server scope and INHERITED by every location below.
    # Repeating them per location is how one of them eventually goes missing
    # from the block that needed it.
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # MCP responses can stream. Buffering them would hold a reply until it
    # completed, which turns an interactive tool call into a stall.
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_request_buffering off;

    # The registration pair, metered. `burst=5 nodelay` lets a caller that has
    # been idle register a handful of keys back to back -- an agent fleet coming
    # up for the first time is a legitimate burst -- while holding the sustained
    # rate at 10 a minute. Exact-match locations (`=`) so nothing else is
    # accidentally caught by a prefix.
    location = /keys {
        limit_req zone=mro_keys burst=5 nodelay;
        proxy_pass http://127.0.0.1:3006;
    }

    location = /keys/nonce {
        limit_req zone=mro_keys burst=5 nodelay;
        proxy_pass http://127.0.0.1:3006;
    }

    # The whole piece is one upstream. /, /llms.txt, /t/<id>, /mcp and the key
    # directory are all the Warden's. NOT metered here: /mcp is authenticated by
    # signature and the reads are cheap, and a limit on this block would meter
    # the artwork's own QR destination.
    location / {
        proxy_pass http://127.0.0.1:3006;
    }
}
